{
  "manifest_version": 2,
  "name": "NVX Capability Probe (MV2)",
  "version": "0.1.0",
  "description": "Opera variant. Establishes whether blocking webRequest is genuinely available, which decides the second netfilter backend.",
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_title": "NVX Capability Probe"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:8787/*"
      ],
      "js": [
        "inject-iso.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "permissions": [
    "declarativeNetRequest",
    "webRequest",
    "webRequestBlocking",
    "cookies",
    "tabs",
    "storage",
    "debugger",
    "<all_urls>"
  ],
  "web_accessible_resources": [
    "probe-asset.js",
    "inject-main.js",
    "panel.html"
  ]
}
